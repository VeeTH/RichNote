<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="RichNote.UserControls.StandardTextEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:RichNote"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <CommandBar
            x:Name="MyEditorCommandBar"
            Grid.Row="0"
            AllowFocusOnInteraction="False"
            Background="WhiteSmoke"
            DefaultLabelPosition="Right"
            FlowDirection="RightToLeft"
            IsOpen="False"
            RequestedTheme="Light">
            <CommandBar.PrimaryCommands>
                <AppBarButton
                    Click="ZoomOut_Click"
                    Icon="ZoomOut"
                    ToolTipService.ToolTip="Zoom Out (Ctrl-Minus)">
                    <AppBarButton.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Subtract" Modifiers="Control"/>
                    </AppBarButton.KeyboardAccelerators>
                </AppBarButton>
                <AppBarButton
                    Click="ZoomIn_Click"
                    Icon="ZoomIn"
                    ToolTipService.ToolTip="Zoom In (Ctrl+Plus)">
                    <AppBarButton.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Add" Modifiers="Control"/>
                    </AppBarButton.KeyboardAccelerators>
                </AppBarButton>
                <AppBarSeparator/>
                <AppBarButton
                    Click="Redo_Click"
                    Icon="Redo"
                    ToolTipService.ToolTip="Redo (Ctrl+Y)">
                    <AppBarButton.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Y" Modifiers="Control"/>
                    </AppBarButton.KeyboardAccelerators>
                </AppBarButton>
                <AppBarButton
                    Click="Undo_Click"
                    Icon="Undo"
                    ToolTipService.ToolTip="Undo (Ctrl+Z)">
                    <AppBarButton.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Z" Modifiers="Control"/>
                    </AppBarButton.KeyboardAccelerators>
                </AppBarButton>
                <AppBarSeparator/>
                <AppBarElementContainer>
                    <TextBlock
                        Padding="20,10,20,0"
                        FontSize="24"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="TXT"
                        ToolTipService.ToolTip="Document Format"/>
                </AppBarElementContainer>
            </CommandBar.PrimaryCommands>
        </CommandBar>

        <TextBox
            x:Name="MyEditorTextBox"
            Grid.Row="1"
            VerticalAlignment="Stretch"
            AcceptsReturn="True"
            BorderThickness="0"
            ContextFlyout="{StaticResource EditorFlyout}"
            CornerRadius="0"
            SelectionFlyout="{StaticResource EditorFlyout}">
            <TextBox.Resources>
                <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="White"/>
                <SolidColorBrush x:Key="TextControlBackground" Color="White"/>
                <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="White"/>
            </TextBox.Resources>
        </TextBox>
    </Grid>
</UserControl>
