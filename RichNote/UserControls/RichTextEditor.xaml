<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="RichNote.UserControls.RichTextEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:RichNote"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <CommandBar
            x:Name="MyEditorCommandBar"
            Grid.Row="0"
            AllowFocusOnInteraction="False"
            Background="WhiteSmoke"
            DefaultLabelPosition="Right"
            FlowDirection="RightToLeft"
            IsOpen="False"
            RequestedTheme="Light">
            <CommandBar.PrimaryCommands>
                <AppBarButton
                    Click="ZoomOut_Click"
                    Icon="ZoomOut"
                    ToolTipService.ToolTip="Zoom Out (Ctrl-Minus)">
                    <AppBarButton.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Subtract" Modifiers="Control"/>
                    </AppBarButton.KeyboardAccelerators>
                </AppBarButton>
                <AppBarButton
                    Click="ZoomIn_Click"
                    Icon="ZoomIn"
                    ToolTipService.ToolTip="Zoom In (Ctrl+Plus)">
                    <AppBarButton.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Add" Modifiers="Control"/>
                    </AppBarButton.KeyboardAccelerators>
                </AppBarButton>
                <AppBarSeparator/>
                <AppBarButton
                    Click="NumberList_Click"
                    Icon="List"
                    ToolTipService.ToolTip="Numbered List">
                </AppBarButton>
                <AppBarButton
                    Click="BulletList_Click"
                    Icon="Bullets"
                    ToolTipService.ToolTip="Bulleted List">
                </AppBarButton>
                <AppBarSeparator/>
                <AppBarButton
                    Click="AlignRight_Click"
                    Icon="AlignRight"
                    ToolTipService.ToolTip="Align Right (Ctrl+R)">
                    <AppBarButton.KeyboardAccelerators>
                        <KeyboardAccelerator Key="R" Modifiers="Control"/>
                    </AppBarButton.KeyboardAccelerators>
                </AppBarButton>
                <AppBarButton
                    Click="AlignCenter_Click"
                    Icon="AlignCenter"
                    ToolTipService.ToolTip="Align Center (Ctrl+E)">
                    <AppBarButton.KeyboardAccelerators>
                        <KeyboardAccelerator Key="E" Modifiers="Control"/>
                    </AppBarButton.KeyboardAccelerators>
                </AppBarButton>
                <AppBarButton
                    Click="AlignLeft_Click"
                    Icon="AlignLeft"
                    ToolTipService.ToolTip="Align Left (Ctrl+L)">
                    <AppBarButton.KeyboardAccelerators>
                        <KeyboardAccelerator Key="L" Modifiers="Control"/>
                    </AppBarButton.KeyboardAccelerators>
                </AppBarButton>
                <AppBarSeparator/>
                <AppBarButton
                    Click="FontSizeDown_Click"
                    Icon="FontDecrease"
                    ToolTipService.ToolTip="Decrease Font Size (Ctrl+Shift+&lt;)">
                    <AppBarButton.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Subtract" Modifiers="Control,Shift"/>
                    </AppBarButton.KeyboardAccelerators>
                </AppBarButton>
                <AppBarElementContainer>
                    <ComboBox
                        x:Name="FontSizeBox"
                        Width="75"
                        Margin="0,7.5,0,0"
                        AllowFocusOnInteraction="True"
                        BorderThickness="1"
                        CornerRadius="0"
                        FlowDirection="LeftToRight"
                        IsEditable="True"
                        IsTextSearchEnabled="False"
                        ItemsSource="{x:Bind fontSizes}"
                        SelectionChanged="FontSizeBox_SelectionChangedSize"
                        TextSubmitted="FontSizeBox_TextSubmittedSize"
                        ToolTipService.ToolTip="Font Size"/>
                </AppBarElementContainer>
                <AppBarButton
                    Click="FontSizeUp_Click"
                    Icon="FontIncrease"
                    ToolTipService.ToolTip="Increase Font Size (Ctrl+Shift+&gt;)">
                    <AppBarButton.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Add" Modifiers="Control"/>
                    </AppBarButton.KeyboardAccelerators>
                </AppBarButton>
                <AppBarButton Icon="Font" ToolTipService.ToolTip="Font"/>
                <AppBarSeparator/>
                <AppBarButton Click="Strikethrough_Click" ToolTipService.ToolTip="Strikethrough">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xEDE0;"/>
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton
                    Click="Underline_Click"
                    Icon="Underline"
                    ToolTipService.ToolTip="Underline (Ctrl+U)">
                    <AppBarButton.KeyboardAccelerators>
                        <KeyboardAccelerator Key="U" Modifiers="Control"/>
                    </AppBarButton.KeyboardAccelerators>
                </AppBarButton>
                <AppBarButton
                    Click="Italics_Click"
                    Icon="Italic"
                    ToolTipService.ToolTip="Italics (Ctrl+I)">
                    <AppBarButton.KeyboardAccelerators>
                        <KeyboardAccelerator Key="I" Modifiers="Control"/>
                    </AppBarButton.KeyboardAccelerators>
                </AppBarButton>
                <AppBarButton
                    Click="Bold_Click"
                    Icon="Bold"
                    ToolTipService.ToolTip="Bold (Ctrl+B)">
                    <AppBarButton.KeyboardAccelerators>
                        <KeyboardAccelerator Key="B" Modifiers="Control"/>
                    </AppBarButton.KeyboardAccelerators>
                </AppBarButton>
                <AppBarSeparator/>
                <AppBarElementContainer>
                    <TextBlock
                        Padding="20,10,20,0"
                        FontSize="24"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="RTF"
                        ToolTipService.ToolTip="Document Format"/>
                </AppBarElementContainer>
            </CommandBar.PrimaryCommands>
        </CommandBar>

        <RichEditBox
            x:Name="MyEditorRichEditBox"
            Grid.Row="1"
            VerticalAlignment="Stretch"
            BorderThickness="0"
            ContextFlyout="{StaticResource EditorFlyout}"
            CornerRadius="0"
            DisabledFormattingAccelerators="All"
            SelectionChanged="RichEditBox_SelectionChanged"
            SelectionFlyout="{x:Null}"
            SelectionHighlightColorWhenNotFocused="{ThemeResource SystemControlHighlightAccentBrush}">
            <RichEditBox.Resources>
                <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="White"/>
                <SolidColorBrush x:Key="TextControlBackground" Color="White"/>
                <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="White"/>
            </RichEditBox.Resources>
        </RichEditBox>
    </Grid>
</UserControl>
